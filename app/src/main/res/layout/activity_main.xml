<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tlo"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/widok"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!--
        Ekran pierwszego uruchomienia. Pokazuje się tylko wtedy, gdy build nie
        ma wpisanego adresu witryny i kierowca nie wszedł przez link z maila.
    -->
    <ScrollView
        android:id="@+id/konfiguracja"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/tekst"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/konfiguracja_opis"
                android:textColor="@color/tekst_slaby"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/pole_adres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:autofillHints="false"
                android:hint="@string/konfiguracja_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:textColor="@color/tekst"
                android:textColorHint="@color/tekst_slaby" />

            <Button
                android:id="@+id/przycisk_otworz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/konfiguracja_otworz" />

            <TextView
                android:id="@+id/wersja"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textColor="@color/tekst_slaby"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
